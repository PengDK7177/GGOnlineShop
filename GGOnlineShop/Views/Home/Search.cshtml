@model IEnumerable<GGOnlineShop.Models.Card>

@{
    ViewData["Title"] = "Searching Results";
    var keyword = ViewData["Keyword"] as string;
}

<h1>Searching Results: "@keyword"</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Not Found</div>
}
else
{
    <div class="row">
        @foreach (var card in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <img src="@card.CardImg" class="card-img-top" alt="@card.PlayerName">
                    <div class="card-body">
                        <h5 class="card-title">@card.PlayerName</h5>
                        <p class="card-text">Categories: @card.Category.Name</p>
                        <p class="card-text">Price: ￡@card.CardPrice</p>

                        <!-- correct action name (Details) with id route -->
                        <a asp-action="Details" asp-controller="Category" asp-route-id="@card.Id" class="card-item btn btn-primary">Check Details</a>

                        <!-- if you want AddToCart to call the POST action via a form or AJAX, use a form
                             below is a simple GET link only if your CartController supports a GET AddToCart -->
                        <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@card.Id" class="btn btn-success">Add to Cart</a>
                    </div>
                </div>
            </div>
        }
    </div>
}