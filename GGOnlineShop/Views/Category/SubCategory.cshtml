@model List<GGOnlineShop.Models.Card>
@{
    ViewData["Title"] = "CardsCategory";
    var subName = ViewData["SubCategoryName"] as string ?? "";
    var subKey = ViewData["SubCategoryKey"] as string ?? "subcategory";
    var subId = ViewData["SubCategoryId"] ?? "";
    var teams = (ViewBag.Teams as List<string>) ?? new List<string>();
    var filter = ViewBag.Filter ?? new { YearFrom = (int?)null, YearTo = (int?)null, PriceFrom = (decimal?)null, PriceTo = (decimal?)null, Team = (string?)null };
    int? yearFrom = filter.YearFrom;
    int? yearTo = filter.YearTo;
    decimal? priceFrom = filter.PriceFrom;
    decimal? priceTo = filter.PriceTo;
    string? team = filter.Team;
}
<link rel="stylesheet" href="~/css/SubCategory.css" asp-append-version="true" />

<!-- Full-bleed background container with translucent overlay.
     The view receives a 'subKey' CSS class (e.g. "nba", "fiba") to apply per-category background images.
     The overlay ensures content remains readable over the background image.
-->
<div class="subcategory-page @subKey">
    <div class="subcategory-content container">
        <h1 class="mt-4 mb-3">@subName</h1>

        <!--
            Filter form (year, price, team) is rendered above the card grid in the controller/view pairing.
            Filters are passed via query string so results are bookmarkable and shareable.
        -->

        <!-- Card list container: grid layout -->
        <div class="card-grid">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center text-muted py-5">No cards available in this category.</div>
            }
            else
            {
                @foreach (var card in Model)
                {
                    <!--
                        Single player-card tile.
                        The anchor links to the Details action so clicking opens the card detail page.
                        Card information is shown inside the tile (name, team, year, price, stock).
                    -->
                    <a asp-action="Details" asp-controller="Category" asp-route-id="@card.Id" class="card-item">
                        <div class="card-img">
                            <img src="@card.CardImg" alt="@card.PlayerName 球星卡" />
                        </div>
                        <div class="card-info">
                            <h3>@card.PlayerName</h3>
                            <p>Team：@card.Team</p>
                            <p>Year：@card.CardYear</p>
                            <p>Price：￡@card.CardPrice</p>
                            <p>Stock：@card.CardStock </p>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</div>
