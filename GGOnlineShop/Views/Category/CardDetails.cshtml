@model GGOnlineShop.Models.Card

@{
    ViewData["Title"] = "Card Details";
}

<!-- Page layout: left info column + right image column + action buttons -->
<div class="detail-container">
    <!-- Left information section: player details and action buttons -->
    <div class="info-section">
        <h1>@Model.PlayerName</h1>
        <p><strong>Team：</strong>@Model.Team</p>
        <p><strong>Year：</strong>@Model.CardYear</p>
        <p><strong>Grade：</strong>@Model.CardGrade</p>
        <p><strong>Price：</strong>￡@Model.CardPrice</p>
        <p><strong>Stock：</strong>@Model.CardStock </p>

        <!-- Action buttons: Purchase link and Add-to-cart form (uses AJAX below) -->
        <div class="button-group">
            <a asp-action="Checkout" asp-controller="Cart" asp-route-id="@Model.Id" class="btn-get-now">!Get Now!</a>

            <form id="addToCartForm" asp-action="AddToCart" asp-controller="Cart" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="cardId" value="@Model.Id" />
                <button type="submit" class="btn-add-cart">Add to Cart</button>
            </form>
        </div>
    </div>

    <!-- Right image section: show the card image -->
    <div class="image-section">
        <img src="@Model.CardImg" alt="@Model.PlayerName 球星卡" class="card-img" />
    </div>
</div>

<!-- Toast container (Bootstrap) used to show add-to-cart feedback -->
<div aria-live="polite" aria-atomic="true" style="position: fixed; top: 1rem; right: 1rem; z-index: 2000;">
    <div id="cartToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="2000">
        <div class="toast-header">
            <strong class="me-auto">Cart</strong>
            <small></small>
            <button type="button" class="btn-close ms-2 mb-1" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">Add successfully</div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            $(function () {
                var $form = $('#addToCartForm');
                var $toastEl = $('#cartToast');

                // Attach AJAX submit handler to add-to-cart form so UI remains on the page
                $form.on('submit', function (e) {
                    e.preventDefault();

                    var $btn = $form.find('button[type="submit"]');
                    $btn.prop('disabled', true);

                    $.ajax({
                        url: $form.attr('action'),
                        method: 'POST',
                        data: $form.serialize(),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        success: function (resp) {
                            // Server returns JSON for AJAX requests: { success, needLogin, message, quantity }
                            if (resp && resp.success) {
                                // display success toast for the configured delay (data-bs-delay=2000)
                                var toast = bootstrap.Toast.getOrCreateInstance($toastEl.get(0));
                                $toastEl.find('.toast-body').text(resp.message || 'Add successfully');
                                toast.show();
                            } else if (resp && resp.needLogin) {
                                // redirect to login if user is not authenticated
                                window.location.href = '/UserInfo/Login';
                            } else {
                                var msg = (resp && resp.message) ? resp.message : 'Add failed';
                                var toast = bootstrap.Toast.getOrCreateInstance($toastEl.get(0));
                                $toastEl.find('.toast-body').text(msg);
                                toast.show();
                            }
                        },
                        error: function () {
                            var toast = bootstrap.Toast.getOrCreateInstance($toastEl.get(0));
                            $toastEl.find('.toast-body').text('Add failed');
                            toast.show();
                        },
                        complete: function () {
                            $btn.prop('disabled', false);
                        }
                    });
                });
            });
        })();
    </script>
}

<style>
    .detail-container {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px;
    }

    .info-section {
        flex: 1;
        margin-right: 20px;
    }

    .image-section {
        flex: 0 0 300px;
    }

    .card-img {
        width: 100%;
        height: auto;
    }

    .button-group {
        margin-top: 20px;
        display: flex;
        gap: 10px;
    }

    .btn-get-now, .btn-add-cart {
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        color: #fff;
        cursor: pointer;
    }

    .btn-get-now {
        background-color: #000;
        border: 2px solid #000;
        text-decoration: none;
    }

    .btn-add-cart {
        background-color: #666;
    }
</style>