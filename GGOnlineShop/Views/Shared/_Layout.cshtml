<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GGOnlineShop</title>
    <style>
        .footer {
           
         
            z-index: 999; /* ensure footer stays above page content/background */
        }

        header {
            position: relative;
            z-index: 100;
        }

        /* 头像圆形样式优化 */
        #userAvatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 8px;
            border: 2px solid #fff;
        }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/Home.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-grid.css" />
    <link rel="stylesheet" href="~/css/football.css" />
    <link rel="stylesheet" href="~/css/basketball.css" />
    <link rel="stylesheet" href="~/css/SubCategory.css" />
    <link rel="stylesheet" href="~/css/CardDetails.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-secondary">
            <div class="container-fluid">
                <a class="navbar-brand" asp-action="Index" asp-controller="Home">GGCard</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Index" asp-controller="Home">HomePage</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href=" " id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                All
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item" asp-action="Basketball" asp-controller="Category" asp-route-id="2">Basketball</a></li>
                                <li><a class="dropdown-item" asp-action="Football" asp-controller="Category" asp-route-id="3">Football</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Index" asp-controller="Cart">Cart</a>
                        </li>
                    </ul>
                    <form class="d-flex" asp-action="Search" asp-controller="Home" method="get">
                        <input class="form-control me-2" type="search" name="keyword" placeholder="Searching..." aria-label="Search" />
                        <button class="btn btn-outline-light" type="submit">Search</button>
                    </form>
                    <div class="nav-item ms-3">
                        @{
                            var userId = Context.Session.GetInt32("UserId");
                            if (userId == null)
                            {
                                <a asp-action="Login" asp-controller="UserInfo" class="btn btn-outline-light">Login</a>
                                <a asp-action="Register" asp-controller="UserInfo" class="btn btn-light ms-2">Register</a>
                            }
                            else
                            {
                                <div class="d-flex align-items-center">
                                    <!-- Use a sensible default src and an onerror fallback. Remove conflicting inline sizes. -->
                                    <img id="userAvatar" src="/images/default-avatar.jpg" alt="User avatar" onerror="this.onerror=null;this.src='/images/default-avatar.jpg';" />
                                    <a asp-action="Edit" asp-controller="UserInfo" class="btn btn-outline-light ms-2">Profile</a>
                                    <a asp-action="Logout" asp-controller="UserInfo" class="btn btn-light ms-2">Logout</a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer bg-secondary text-light">
        <div class="container-fluid text-lg-center py-2">
            &copy; 2025 GGOnlineShop - All rights reserved.
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(function () {
            var userId = @(Context.Session.GetInt32("UserId") ?? -1);
            if (userId > 0) {
                $.ajax({
                    url: "/UserInfo/GetCurrentUser",
                    type: "GET",
                    dataType: "json",
                    success: function (user) {
                        var avatar = (user && user.avatarUrl) ? user.avatarUrl : "/images/default-avatar.jpg";
                        // Ensure avatar path is absolute and append a cache-busting token
                        if (avatar.indexOf('/') !== 0 && avatar.indexOf('http') !== 0) {
                            avatar = '/' + avatar;
                        }
                        avatar = avatar + (avatar.indexOf('?') === -1 ? ('?v=' + Date.now()) : ('&v=' + Date.now()));
                        $("#userAvatar").attr("src", avatar);
                    },
                    error: function () {
                        console.error("Failed to fetch user avatar.");
                    }
                });
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>