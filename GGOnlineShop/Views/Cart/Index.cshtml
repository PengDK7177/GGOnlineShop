@model List<GGOnlineShop.Models.CartItem>

@{
    ViewData["Title"] = "Your Shopping Cart";
    decimal subtotal = (decimal)ViewData["Subtotal"];
}

<div class="cart-container">
    <!-- 购物车列表 -->
    <div class="cart-items">
        @foreach (var item in Model)
        {
            <div class="cart-item">
                <!-- 卡片图片 -->
                <div class="item-img">
                    <img src="@item.Card.CardImg" alt="@item.Card.PlayerName" />
                </div>
                <!-- 卡片信息 -->
                <div class="item-info">
                    <h3>@item.Card.PlayerName</h3>
                    <p>单价：¥@item.Card.CardPrice</p>
                </div>
                <!-- 数量控制 -->
                <div class="item-quantity">
                    <button class="btn-minus" asp-action="RemoveFromCart" asp-controller="Cart" asp-route-id="@item.CardId">-</button>
                    <span>@item.Quantity</span>
                    <button class="btn-plus" asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.CardId">+</button>
                </div>
                <!-- 单项总价 -->
                <div class="item-total">
                    ¥@(item.Card.CardPrice* item.Quantity)
                </div>
                <!-- 删除按钮 -->
                <div class="item-remove">
                    <form asp-action="RemoveFromCart" asp-controller="Cart" method="post">
                        <input type="hidden" name="id" value="@item.CardId" />
                        <button type="submit">×</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- 底部操作区 -->
    <div class="cart-footer">
        <a asp-action="Index" asp-controller="Home" class="btn-back">Back to Shop</a>
        <div class="cart-subtotal">
            <span>Subtotal:</span>
            <span>¥@subtotal</span>
        </div>
        <a asp-action="Checkout" asp-controller="Cart" asp-route-id="@(Model.FirstOrDefault()?.CardId ?? 0)" class="btn-checkout">Checkout</a>
    </div>
</div>

<style>
    .cart-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .cart-items {
        margin-bottom: 30px;
    }

    .cart-item {
        display: flex;
        align-items: center;
        padding: 15px;
        border-bottom: 1px solid #eee;
    }

    .item-img img {
        width: 80px;
        height: auto;
        margin-right: 20px;
    }

    .item-info {
        flex: 1;
    }

    .item-quantity {
        display: flex;
        align-items: center;
        margin: 0 20px;
    }

        .item-quantity button, .item-remove button {
            width: 30px;
            height: 30px;
            border: none;
            background-color: #ddd;
            cursor: pointer;
        }

        .item-quantity span {
            width: 30px;
            text-align: center;
        }

    .item-total {
        min-width: 100px;
        text-align: right;
    }

    .cart-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-back, .btn-checkout {
        padding: 10px 20px;
        text-decoration: none;
        color: #333;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

    .btn-checkout {
        background-color: #fcc000;
        color: #fff;
        border-color: #fcc000;
    }

    .cart-subtotal {
        font-weight: bold;
    }
</style>