@model List<GGOnlineShop.Models.CartItem>

@{
    ViewData["Title"] = "Your Shopping Cart";
    decimal subtotal = 0m;
    if (ViewData["Subtotal"] != null)
    {
        subtotal = (decimal)ViewData["Subtotal"];
    }
}

<div class="cart-container">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-cart text-center py-5">
            <h3>Your Cart is still empty</h3>
            <p class="text-muted">Browse the shop and add some items to your cart.</p>
            <a asp-action="Index" asp-controller="Home" class="btn btn-primary mt-3">Back to Shop</a>
        </div>
    }
    else
    {
        <!-- Cart items list -->
        <div class="cart-items">
            @foreach (var item in Model)
            {
                <div class="cart-item">
                    <!-- Card image -->
                    <div class="item-img">
                        <img src="@item.Card.CardImg" alt="@item.Card.PlayerName" />
                    </div>
                    <!-- Card information -->
                    <div class="item-info">
                        <h3>@item.Card.PlayerName</h3>
                        <p>Unit Price：￡@item.Card.CardPrice</p>
                    </div>
                    <!-- Quantity controls (decrease, increase, current quantity) -->
                    <div class="item-quantity">
                        <!-- Decrease button: uses RemoveFromCart to decrement or remove -->
                        <a class="btn btn-secondary btn-sm" asp-action="RemoveFromCart" asp-controller="Cart" asp-route-id="@item.CardId">-</a>

                        <!-- Increase button: submits a POST to AddToCart with antiforgery token to match controller [HttpPost] -->
                        <form asp-action="AddToCart" asp-controller="Cart" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="cardId" value="@item.CardId" />
                            <button type="submit" class="btn btn-secondary btn-sm" @(item.Quantity >= item.Card.CardStock ? "disabled" : "")>+</button>
                        </form>

                        <span class="mx-2">@item.Quantity</span>
                    </div>
                    <!-- Item total price -->
                    <div class="item-total">
                        ¥@(item.Card.CardPrice * item.Quantity)
                    </div>
                    <!-- Remove item button (full remove) -->
                    <div class="item-remove">
                        <form asp-action="RemoveFromCart" asp-controller="Cart" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.CardId" />
                            <button type="submit" class="btn btn-danger btn-sm">×</button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <!-- Footer area: navigation and subtotal -->
        <div class="cart-footer d-flex justify-content-between align-items-center mt-4">
            <a asp-action="Index" asp-controller="Category" class="btn btn-outline-secondary">Back to Shop</a>
            <div class="cart-subtotal">
                <span class="me-2">Subtotal:</span>
                <span class="fw-bold">￡@subtotal</span>
            </div>
            <a asp-action="Checkout" asp-controller="Cart" class="btn btn-warning">Checkout</a>
        </div>
    }
</div>

<style>
    .cart-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .cart-items {
        margin-bottom: 30px;
    }

    .cart-item {
        display: flex;
        align-items: center;
        padding: 15px;
        border-bottom: 1px solid #eee;
        gap: 12px;
    }

    .item-img img {
        width: 80px;
        height: auto;
        margin-right: 20px;
    }

    .item-info {
        flex: 1;
    }

    .item-quantity {
        display: flex;
        align-items: center;
        margin: 0 20px;
    }

    /* Make both <a> and <button> controls share the same sizing and appearance */
    .item-quantity a,
    .item-quantity button,
    .item-remove button {
        width: 32px;
        height: 32px;
        box-sizing: border-box;
        padding: 0;                     /* remove bootstrap padding so width/height control size */
        line-height: 1;
        font-size: 16px;
        border: none;
        background-color: #ddd;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .item-quantity a[disabled],
    .item-quantity button[disabled] {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .item-quantity span {
        width: 36px;
        text-align: center;
    }

    .item-total {
        min-width: 100px;
        text-align: right;
    }

    .cart-footer .cart-subtotal {
        font-weight: bold;
    }

    .empty-cart h3 {
        margin-bottom: 0.5rem;
    }
</style>