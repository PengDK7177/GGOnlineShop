
@model IEnumerable<GGOnlineShop.Models.CartItem>

@{
    ViewData["Title"] = "Cart";
}

<h1>Cart</h1>

@if (Model.Count() == 0)
{
    <div class="alert alert-info">Your Cart is empty</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Cards</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Operation</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.Card.CardImg" width="80" alt="@item.Card.PlayerName" />
                        <span>@item.Card.PlayerName</span>
                    </td>
                    <td>¥@item.Card.CardPrice</td>
                    <td>
                        <input type="number" value="@item.Quantity" min="1" class="form-control" />
                    </td>
                    <td>¥@(item.Card.CardPrice * item.Quantity)</td>
                    <td>
                        <a asp-action="RemoveFromCart" asp-controller="Cart" asp-route-id="@item.Card.Id" class="btn btn-danger">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3"></td>
                <td>
                    <h4>Total: ¥@(Model.Sum(i => i.Card.CardPrice * i.Quantity))</h4>
                </td>
                <td>
                    <a asp-action="Checkout" asp-controller="Cart" class="btn btn-success">结算</a>
                </td>
            </tr>
        </tfoot>
    </table>
}