@model GGOnlineShop.Models.UserInfo

<h1>Edit My Info</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Username"></label>
        <input asp-for="Username" class="form-control" readonly /> <!-- 用户名通常不可修改 -->
    </div>
    <div class="form-group">
        <label asp-for="Avatar"></label>
        <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*" />
        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
            <img src="@Model.AvatarUrl" alt="Current Avatar" style="width: 80px; height: 80px; border-radius: 50%; margin-top: 8px;" />
        }
    </div>
    <div class="form-group">
        <label asp-for="Age"></label>
        <input asp-for="Age" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Gender"></label>
        <input asp-for="Gender" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="FavoriteTeam"></label>
        <input asp-for="FavoriteTeam" class="form-control" />
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">Back to Home</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}