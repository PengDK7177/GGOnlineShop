@model GGOnlineShop.Models.UserInfo

@{
    ViewData["Title"] = "Register";
}

<h1>Register</h1>

<!--
    Registration form.
    - Uses antiforgery token for POST protection.
    - Avatar upload is optional.
    - Client and server side validation are enabled via data annotations and unobtrusive scripts.
-->
<form asp-action="Register" method="post" enctype="multipart/form-data" autocomplete="off">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" autocomplete="username" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
        <small class="form-text text-muted">At least 8 characters and include uppercase, lowercase, number and symbol.</small>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AvatarFile" class="form-label">Avatar</label>
        <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*" />
        <span asp-validation-for="AvatarFile" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <input type="submit" value="Register" class="btn btn-primary" />
        <a asp-action="Login" asp-controller="UserInfo" class="btn btn-secondary ms-2">Back to Login</a>
    </div>
</form>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
}